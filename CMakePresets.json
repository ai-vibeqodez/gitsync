{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GITSYNC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "clang18-libcxx",
      "inherits": "dev",
      "displayName": "Clang 18 + libc++",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -std=c++23"
      }
    },
    {
      "name": "release",
      "inherits": "clang18-libcxx",
      "displayName": "Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GITSYNC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Windows)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GITSYNC_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "/std:c++latest /EHsc"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (Windows)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GITSYNC_BUILD_TESTS": "OFF",
        "GITSYNC_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CXX_FLAGS": "/std:c++latest /EHsc"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang18-libcxx",
      "configurePreset": "clang18-libcxx"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "clang18-libcxx",
      "configurePreset": "clang18-libcxx",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
